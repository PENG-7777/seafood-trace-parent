<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.peng.node.mapper.ProcessBatchMapper">

    <resultMap id="ProcessBatchResultMap" type="com.peng.node.entity.ProcessBatch">
        <id column="pb_id" property="pbId"/>
        <result column="batch_id" property="batchId"/>
        <result column="node_id" property="nodeId"/>
        <result column="source_node_type" property="sourceNodeType"/>
        <result column="source_batch_id" property="sourceBatchId"/>
        <result column="type" property="type"/>
        <result column="process_no" property="processNo"/>
        <result column="process_person" property="processPerson"/>
        <result column="process_date" property="processDate"/>
        <result column="cold_storage_info" property="coldStorageInfo"/>
        <result column="state" property="state"/>
        <result column="remarks" property="remarks"/>
        <!-- 重点：数据库字段是name，映射到实体nodeName -->
        <result column="name" property="nodeName"/>
    </resultMap>

    <select id="selectProcessApplyList" resultMap="ProcessBatchResultMap">
        SELECT
        pb.*,
        ni.name
        FROM process_batch pb
        LEFT JOIN node_info ni ON pb.node_id = ni.node_id
        WHERE
        pb.source_batch_id IN
        <foreach collection="fsbIdList" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        AND pb.state = 2
        AND pb.source_node_type = 2
    </select>

</mapper>
