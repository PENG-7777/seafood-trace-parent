<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.peng.node.mapper.ProvinceMapper">
    <select id="selectAll" resultType="com.peng.node.entity.Province">
        select prov_id, prov_name
        from province
        order by prov_id asc
    </select>
</mapper>
